{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HyperVPN",
  "version": "2.0.0",
  "identifier": "com.hypervpn.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "HyperVPN",
        "width": 390,
        "height": 660,
        "minWidth": 380,
        "minHeight": 640,
        "maxWidth": 430,
        "maxHeight": 720,
        "resizable": false,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "tooltip": "HyperVPN - Fast Native VLESS Client"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "binaries/*"
    ]
  },
  "plugins": {}
}
